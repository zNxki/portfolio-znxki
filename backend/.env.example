# backend/.env.example
# In produzione deve essere https://tuodominio (abilita cookie Secure e HSTS)
PUBLIC_URL=http://localhost:8080
BIND_ADDR=127.0.0.1:8080
# Runtime: ruolo con soli privilegi DML. Migrazioni: ruolo owner (vedi deploy/db.sql)
DATABASE_URL=postgres://portfolio_app:PASSWORD_APP@localhost:5432/portfolio
MIGRATION_DATABASE_URL=postgres://portfolio_owner:PASSWORD_OWNER@localhost:5432/portfolio
DB_MAX_CONNECTIONS=10
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OBBLIGATORIO: ID numerici GitHub (non username) degli admin, separati da virgola.
# Solo questi account possono accedere al pannello. Trova il tuo ID: https://api.github.com/users/<username>
ADMIN_GITHUB_IDS=
APP_SECRET=sostituisci-con-almeno-32-caratteri-casuali
FRONTEND_DIR=..
ADMIN_DIR=./admin
UPLOAD_DIR=./uploads
# true SOLO dietro Nginx (usa X-Real-IP); false se esposto direttamente
TRUST_PROXY=true
SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=43200
SESSION_ROTATE_SECS=900
RATE_PUBLIC_PER_MIN=300
RATE_AUTH_PER_MIN=20
RATE_ADMIN_PER_MIN=240
MAX_JSON_BYTES=1048576
MAX_UPLOAD_BYTES=8388608
LOG_FORMAT=json
RUST_LOG=info
